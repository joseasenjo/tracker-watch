        "SOCS": "your choices about cookies (about 13 months)",
        "AEC": "detecting spam, fraud and abuse in advertising (about 6 months)",
        "SID": "signing in and security (about 2 years)",
        "HSID": "signing in and security (about 2 years)",
        "CGIC": "autocompleting search queries (about 6 months)",
